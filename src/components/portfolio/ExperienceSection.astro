const contributionCount = ossContributions.reduce((sum, group) => sum + group.items.length, 0);
const pullRequestCount = ossContributions.reduce(
  (sum, group) => sum + group.items.filter((item) => item.type === 'PR').length,
  0
);
const issueCount = contributionCount - pullRequestCount;
---

<section id="experience" class="mb-10">
  <h2 class="section-title">experience</h2>

  <div class="exp-block">
    <h3 class="exp-title">
      framework-agnostic 경량 스크롤 라이브러리 Scrolloop 개발 및 운영
      <ChipLink href="https://github.com/zaewc/scrolloop" icon="bi-github" label="GitHub" />
      <ChipLink href="https://www.npmjs.com/package/scrolloop" icon="bi-box-seam" label="npm" />
    </h3>
    <ul class="bul-list">
      <li>
        windowing 기법으로 렌더링하는 VirtualList와 이를 이용한 무한 스크롤을 지원하는 InfiniteList
        제공
      </li>
      <li>turbopack 기반 모노레포 구조로 React, React Native, Vue, Svelte를 동시에 지원</li>
      <li>
        n8n·GitHub Actions·3-Agent Harness(Planner / Generator / Evaluator)를 연동해 이슈 라벨링부터
        AI 기반 PR 생성까지 자동화
      </li>
      <li>
        <strong>약 40KB, 디펜던시 0개</strong><Fn note="최소 설계를 목표로 함" />로 구현, 누적 <strong
          >다운로드 4,700+건, GitHub star 30</strong
        >
      </li>
    </ul>
  </div>

  <div class="exp-block">
    <h3 class="exp-title">
      교내 Discord 편의성 봇 JEE6 개발 및 운영
      <ChipLink href="https://github.com/8G4B/JEE6.v1" icon="bi-github" label="GitHub" />
    </h3>
    <ul class="bul-list">
      <li>서버 관리, 급식 조회, 욕설 메시지 필터, 미니게임 등을 제공하는 Discord 봇</li>
      <li>
        Ubuntu, Docker Compose 기반으로 6개 서비스를 분리 운영하고, FastAPI Gateway·Redis TTL
        캐싱으로 외부 API 호출 최적화
      </li>
      <li>
        학교 공식 디스코드 서버를 포함한 <strong>50+개 서버 도입, DAU 100+명</strong>
      </li>
    </ul>
  </div>

  <div class="exp-block">
    <a href="/ml#project" class="ml-link">
      <span class="ml-link-title">MLOps 엔지니어 경험</span>
      <i class="bi bi-arrow-right ml-link-arrow"></i>
    </a>
  </div>

  <div class="exp-block">
    <div class="oss-heading">
      <h3 class="exp-title">오픈소스 기여</h3>
      <span class="oss-total"
        >{contributionCount} contributions · {pullRequestCount} PR · {issueCount} issues</span
      >
    </div>

    <div class="oss-groups">
      {
        ossContributions.map((group, groupIndex) => (
          <details class="oss-group" open={groupIndex === 0}>
            <summary>
              <span class="oss-project">
                <i class="bi bi-github" aria-hidden="true" />
                {group.project}
              </span>
              <span class="oss-count">{group.items.length}</span>
            </summary>
            <ol class="oss-list">
              {group.items.map((item) => (
                <li>
                  <time datetime={item.date.replaceAll('.', '-')}>{item.date}</time>
                  <span class:list={['oss-type', item.type === 'PR' ? 'is-pr' : 'is-issue']}>
                    {item.type}
                  </span>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    <span>{item.title}</span>
                    <span class="oss-id">{item.id} ↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exp-block {
    margin-bottom: 1.25rem;
  }
  .exp-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.375rem;
  }
  .ml-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.15s;
  }
  .ml-link:hover {
    color: var(--accent);
  }
  .ml-link:hover .ml-link-arrow {
    transform: translateX(3px);
  }
  .ml-link-title {
    font-size: 0.875rem;
    font-weight: 700;
  }
  .ml-link-arrow {
    font-size: 0.875rem;
    transition: transform 0.15s;
  }

  .oss-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .oss-total {
    color: var(--text-faint);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .oss-groups {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .oss-group {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .oss-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding: 0 0.9rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .oss-group summary::-webkit-details-marker {
    display: none;
  }

  .oss-project {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .oss-project i {
    color: var(--text-faint);
  }

  .oss-count {
    display: grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    border-radius: 99px;
    background: var(--accent-light);
    color: var(--accent);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.62rem;
  }

  .oss-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .oss-list li {
    display: grid;
    grid-template-columns: 5.2rem 2.8rem minmax(0, 1fr);
    align-items: start;
    gap: 0.55rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
  }

  .oss-list li:last-child {
    border-bottom: 0;
  }

  .oss-list time,
  .oss-type,
  .oss-id {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6rem;
  }

  .oss-list time {
    padding-top: 0.16rem;
    color: var(--text-faint);
  }

  .oss-type {
    width: fit-content;
    padding: 0.15rem 0.35rem;
    border-radius: 0.3rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .oss-type.is-pr {
    background: color-mix(in srgb, #3ddc84 14%, transparent);
    color: color-mix(in srgb, #159447 82%, var(--text));
  }

  .oss-type.is-issue {
    background: color-mix(in srgb, var(--accent-2) 13%, transparent);
    color: var(--accent-2);
  }

  .oss-list a {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.55;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .oss-list a:hover {
    color: var(--accent);
  }

  .oss-id {
    flex: 0 0 auto;
    padding-top: 0.12rem;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .oss-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .oss-total {
      white-space: normal;
    }

    .oss-list li {
      grid-template-columns: 1fr auto;
      gap: 0.35rem 0.5rem;
    }

    .oss-list time {
      grid-column: 1;
    }

    .oss-type {
      grid-column: 2;
      grid-row: 1;
    }

    .oss-list a {
      grid-column: 1 / -1;
    }
  }
</style>
