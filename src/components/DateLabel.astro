---
interface Props {
  date: string;
}
const { date } = Astro.props;
---

<span class="date-label">{date}</span>

<style>
  .date-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
