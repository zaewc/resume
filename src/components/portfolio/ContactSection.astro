---
const contacts = [
  { icon: 'bi-envelope', label: 'me@zaewc.site', href: 'mailto:me@zaewc.site' },
  { icon: 'bi-telephone', label: '010-7745-5407', href: 'tel:010-7745-5407' },
  {
    icon: 'bi-github',
    label: 'github.com/zaewc',
    href: 'https://github.com/zaewc',
    external: true,
  },
  {
    icon: 'bi-journal-text',
    label: 'velog.io/@haensol',
    href: 'https://velog.io/@haensol/posts',
    external: true,
  },
];
---

<!-- 연락처는 별도 섹션 제목 없이 소개 바로 아래 한 줄로: 첫 화면에서 바로 보이게 -->
<section id="contact" class="contact" aria-label="연락처">
  <ul class="contact-list">
    {
      contacts.map((c) => (
        <li>
          <i class={`bi ${c.icon} contact-icon`} aria-hidden="true" />
          <a
            href={c.href}
            {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {c.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .contact {
    margin-top: -1.75rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media screen {
    :global(main.resume-web) > .contact {
      margin-bottom: 2.75rem;
    }
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .contact-list a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s;
  }
  .contact-list a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-icon {
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  @media (max-width: 479px) {
    .contact-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem 1rem;
    }
  }
  @media print {
    .contact {
      margin-top: 0;
      padding: 0.35rem 0;
    }
  }
</style>
