---
import LinkIcon from './LinkIcon.astro';

interface Props {
  href: string;
  id: string; // e.g. "#11430"
}
const { href, id }: Props = Astro.props;
const githubMatch = href.match(
  /^https:\/\/github\.com\/[^/]+\/[^/]+\/(pull|issues)\/(\d+)(?:[/?#]|$)/
);
const label = githubMatch ? `${githubMatch[1] === 'pull' ? 'PR' : 'Issue'} #${githubMatch[2]}` : id;
const kind = githubMatch ? (githubMatch[1] === 'pull' ? 'pr' : 'issue') : undefined;
const icon = {
  blog: 'bi-journal-text',
  survey: 'bi-clipboard-check',
  article: 'bi-newspaper',
}[id];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="pr-link"
  aria-label={label}
  title={label}
>
  <LinkIcon kind={kind} icon={icon} />
  {githubMatch ? `#${githubMatch[2]}` : id}
</a>

<style>
  .pr-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin-left: 0.4rem;
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    color: var(--text-faint);
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
    user-select: none;
  }
  .pr-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
