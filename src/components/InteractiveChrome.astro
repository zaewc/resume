---
interface Props {
  mode?: 'web' | 'ml';
}

const { mode = 'web' }: Props = Astro.props;
---

<div class="experience-bg" aria-hidden="true">
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>
  <div class="noise"></div>
</div>

<div class="cursor-aura" aria-hidden="true"></div>

<header class="experience-header">
  <a class="brand-mark" href="#top" aria-label="페이지 맨 위로">
    <span class="brand-dot"></span>
    <span>SJW<span class="brand-slash">/</span>{mode === 'ml' ? 'ML' : 'WEB'}</span>
  </a>

  <div class="header-status" aria-label="현재 상태">
    <span class="status-pulse"></span>
    <span>OPEN TO WORK · SEP 2026</span>
  </div>
</header>

<aside class="section-rail" aria-label="페이지 섹션">
  <span class="rail-caption">INDEX</span>
  <nav id="section-nav"></nav>
  <span class="rail-progress"><span id="rail-progress-value"></span></span>
</aside>

<div class="scroll-counter" aria-hidden="true">
  <span id="scroll-percent">00</span><span class="counter-unit">%</span>
</div>

<script>
  const root = document.documentElement;
  const cursorAura = document.querySelector<HTMLElement>('.cursor-aura');
  const scrollPercent = document.getElementById('scroll-percent');
  const railProgress = document.getElementById('rail-progress-value');
  const sectionNav = document.getElementById('section-nav');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const titleMap: Record<string, string> = {
    contact: 'Connect',
    career: 'Selected work',
    project: 'Projects',
    experience: 'Open source',
    activities: 'Leadership',
    skills: 'Toolkit',
    background: 'Background',
  };

  const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section'));
  sections.forEach((section, index) => {
    const title = section.querySelector('.section-title')?.textContent?.trim().toLowerCase();
    if (!section.id) section.id = title || `section-${index + 1}`;
    section.dataset.sectionIndex = String(index + 1).padStart(2, '0');

    if (sectionNav && title) {
      const link = document.createElement('a');
      link.href = `#${section.id}`;
      link.textContent = titleMap[title] ?? title;
      link.dataset.target = section.id;
      sectionNav.append(link);
    }
  });

  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#section-nav a'));
  const visibleSections = sections.filter((section) => section.id !== 'top');
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) =>
          link.classList.toggle('active', link.dataset.target === entry.target.id)
        );
      });
    },
    { rootMargin: '-25% 0px -60% 0px', threshold: 0 }
  );
  visibleSections.forEach((section) => sectionObserver.observe(section));

  const revealItems = document.querySelectorAll<HTMLElement>(
    'main > section, .proj-block, .exp-block, .contact-list, .availability'
  );
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('in-view');
        revealObserver.unobserve(entry.target);
      });
    },
    { threshold: 0.06, rootMargin: '0px 0px -5% 0px' }
  );
  revealItems.forEach((item) => revealObserver.observe(item));

  const updateScroll = () => {
    const total = document.documentElement.scrollHeight - window.innerHeight;
    const progress = total > 0 ? Math.min(1, window.scrollY / total) : 0;
    const value = Math.round(progress * 100)
      .toString()
      .padStart(2, '0');
    if (scrollPercent) scrollPercent.textContent = value;
    if (railProgress) railProgress.style.height = `${progress * 100}%`;
    root.style.setProperty('--scroll-shift', `${progress * -80}px`);
  };

  window.addEventListener('scroll', updateScroll, { passive: true });
  updateScroll();

  if (!reduceMotion) {
    window.addEventListener(
      'pointermove',
      (event) => {
        root.style.setProperty('--pointer-x', `${event.clientX}px`);
        root.style.setProperty('--pointer-y', `${event.clientY}px`);
        cursorAura?.classList.add('visible');
      },
      { passive: true }
    );

    const interactiveCards = document.querySelectorAll('.proj-block, .exp-block, .availability');
    interactiveCards.forEach((element) => {
      const card = element as HTMLElement;
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;
        card.style.setProperty('--card-x', `${x * 100}%`);
        card.style.setProperty('--card-y', `${y * 100}%`);
        card.style.setProperty('--tilt-x', `${(0.5 - y) * 1.25}deg`);
        card.style.setProperty('--tilt-y', `${(x - 0.5) * 1.25}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
      });
    });
  }
</script>
