---
interface Props {
  active: 'web' | 'ml';
}
const { active }: Props = Astro.props;
---

<section class="mb-12">
  <h1 class="name">
    송재욱
    <span class="name-sub name-sub-web">
      (<a
        href="/"
        class:list={['role-tab', { active: active === 'web' }]}
        aria-current={active === 'web' ? 'page' : undefined}>Software Engineer</a
      >
      <span class="role-sep" aria-hidden="true">·</span>
      <a
        href="/ml"
        class:list={['role-tab', { active: active === 'ml' }]}
        aria-current={active === 'ml' ? 'page' : undefined}>MLOps</a
      >)
    </span>
    <span class="name-sub name-sub-print">({active === 'web' ? 'Software Engineer' : 'MLOps'})</span
    >
  </h1>
  <!-- 이력서 소개는 컨셉 + 근거 2문장. 세부 성과는 아래 섹션에서 -->
  <p class="bio">
    <span class="bio-lead"
      >사용자와 이해관계자의 이야기에서 진짜 문제를 찾아, 가장 단순하고 비용 효율적인 해법으로
      끝까지 구현합니다.</span
    >
    공공기관 프로젝트 3건을 개발·운영하며 이를 실천했고, 프론트엔드에서 백엔드·MLOps까지 문제 해결에 필요한
    기술을 넓혀 왔습니다.
  </p>
</section>

<style>
  .name {
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.625rem;
    line-height: 1.2;
  }
  @media (min-width: 640px) {
    .name {
      font-size: 2.25rem;
    }
  }
  .name-sub {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .name-sub-print {
    display: none;
  }
  .role-tab {
    color: var(--text-faint);
    text-decoration: none;
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
  }
  .role-tab:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .role-tab.active {
    color: var(--text);
    font-weight: 700;
    pointer-events: none;
  }
  .role-sep {
    color: var(--text-faint);
    margin: 0 0.15rem;
  }
  .bio {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .bio-lead {
    display: block;
    font-weight: 700;
    color: var(--text);
  }
  @media print {
    .name-sub-web {
      display: none;
    }
    .name-sub-print {
      display: inline;
      color: var(--text);
      font-weight: 700;
    }
    .bio.bio {
      font-size: 10pt !important;
    }
  }
</style>
