---
import LinkIcon from './LinkIcon.astro';

interface Props {
  href: string;
  icon: string; // Bootstrap Icon class e.g. "bi-github"
  label: string;
}
const { href, icon, label }: Props = Astro.props;
const kind = new URL(href).hostname === 'www.npmjs.com' ? 'npm' : undefined;
---

<a href={href} target="_blank" rel="noopener noreferrer" class="chip-link">
  <LinkIcon kind={kind} icon={icon} />
  {label}
</a>

<style>
  .chip-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.68rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    text-decoration: none;
    white-space: nowrap;
    vertical-align: middle;
    transition:
      color 0.15s,
      border-color 0.15s;
    user-select: none;
  }
  .chip-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-light);
  }
</style>
