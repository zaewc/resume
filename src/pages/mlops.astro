<script>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  document.querySelectorAll('.project-figure a').forEach((frame) => {
    const image = frame.querySelector('img');
    if (!image) return;

    frame.setAttribute('draggable', 'false');
    image.setAttribute('draggable', 'false');

    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let startTranslateX = 0;
    let startTranslateY = 0;
    let floatFrame = null;
    let floatImage = null;

    const removeFloatImage = () => {
      if (!floatFrame) return;
      floatFrame.remove();
      floatFrame = null;
      floatImage = null;
      frame.classList.remove('is-floating');
    };

    const ensureFloatImage = () => {
      if (floatImage) return floatImage;
      floatFrame = document.createElement('div');
      floatFrame.className = 'zoom-float-frame';
      floatImage = image.cloneNode();
      floatImage.className = 'zoom-float-image';
      floatImage.setAttribute('draggable', 'false');
      floatImage.setAttribute('aria-hidden', 'true');
      floatFrame.appendChild(floatImage);
      document.body.appendChild(floatFrame);
      frame.classList.add('is-floating');
      return floatImage;
    };

    const clampPan = (rect) => {
      const maxX = (rect.width * (scale - 1)) / 2;
      const maxY = (rect.height * (scale - 1)) / 2;
      translateX = clamp(translateX, -maxX, maxX);
      translateY = clamp(translateY, -maxY, maxY);
    };

    const render = () => {
      if (scale <= 1.01) {
        removeFloatImage();
        return;
      }

      const rect = image.getBoundingClientRect();
      const activeImage = ensureFloatImage();
      clampPan(rect);
      floatFrame.style.left = `${rect.left}px`;
      floatFrame.style.top = `${rect.top}px`;
      floatFrame.style.width = `${rect.width}px`;
      floatFrame.style.height = `${rect.height}px`;
      activeImage.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
    };

    const reset = () => {
      scale = 1;
      translateX = 0;
      translateY = 0;
      render();
    };

    frame.addEventListener('click', (event) => {
      event.preventDefault();
    });

    frame.addEventListener('dragstart', (event) => {
      event.preventDefault();
    });

    frame.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();

        const rect = frame.getBoundingClientRect();
        const pointerX = event.clientX - rect.left - rect.width / 2;
        const pointerY = event.clientY - rect.top - rect.height / 2;
        const previousScale = scale;
        const normalizedDelta = clamp(event.deltaY, -120, 120);
        const zoomStep = Math.exp(-normalizedDelta * 0.00045);
        const nextScale = clamp(scale * zoomStep, 1, 8);

        if (nextScale === previousScale) return;

        const zoomRatio = nextScale / previousScale;
        translateX = pointerX - (pointerX - translateX) * zoomRatio;
        translateY = pointerY - (pointerY - translateY) * zoomRatio;
        scale = nextScale;

        if (scale === 1) {
          translateX = 0;
          translateY = 0;
        }

        render();
      },
      { passive: false }
    );

    frame.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      isDragging = true;
      dragStartX = event.clientX;
      dragStartY = event.clientY;
      startTranslateX = translateX;
      startTranslateY = translateY;
      frame.classList.add('is-dragging');
      frame.setPointerCapture(event.pointerId);
    });

    frame.addEventListener('pointermove', (event) => {
      if (!isDragging) return;
      translateX = startTranslateX + event.clientX - dragStartX;
      translateY = startTranslateY + event.clientY - dragStartY;
      render();
    });

    const stopDrag = (event) => {
      if (!isDragging) return;
      isDragging = false;
      frame.classList.remove('is-dragging');
      if (frame.hasPointerCapture(event.pointerId)) {
        frame.releasePointerCapture(event.pointerId);
      }
    };

    frame.addEventListener('pointerup', stopDrag);
    frame.addEventListener('pointercancel', stopDrag);
    frame.addEventListener('dblclick', reset);
    window.addEventListener('scroll', render, { passive: true });
    window.addEventListener('resize', render);
  });
</script>
