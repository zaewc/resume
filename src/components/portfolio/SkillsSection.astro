---
const skills = [
  { label: 'Language', items: 'TypeScript, JavaScript, Python' },
  { label: 'Web·Mobile', items: 'React, Next.js, React Native (Expo)' },
  { label: 'Backend', items: 'FastAPI, Django, Flask, Nest.js, Redis' },
  { label: 'AI·Serving', items: 'vLLM, Transformer' },
  { label: 'Delivery', items: 'Docker, GitHub Actions, Vercel, Git' },
];
---

<section id="skills" class="mb-10">
  <h2 class="section-title">skills</h2>
  <dl class="skill-grid">
    {
      skills.map((skill) => (
        <div class="skill-row">
          <dt>{skill.label}</dt>
          <dd>{skill.items}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .skill-grid {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    line-height: 1.7;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
  }
  .skill-row dt {
    color: var(--text);
    font-weight: 600;
  }
  .skill-row dd {
    margin: 0;
    color: var(--text-muted);
  }
</style>
