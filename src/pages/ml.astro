<script>
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImage = document.getElementById('lightbox-image');
  const lightboxClose = lightbox?.querySelector('.lightbox-close');
  const lightboxScale = document.getElementById('lightbox-scale');
  const lightboxZoomIn = document.getElementById('lightbox-zoom-in');
  const lightboxZoomOut = document.getElementById('lightbox-zoom-out');
  const lightboxReset = document.getElementById('lightbox-reset');

  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
  let lightboxZoom = 1;
  let lightboxX = 0;
  let lightboxY = 0;
  let isLightboxDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let startX = 0;
  let startY = 0;
  let activePointers = new Map();
  let pinchStartDistance = 0;
  let pinchStartZoom = 1;
  let gestureStartZoom = 1;
  let lightboxOpenToken = 0;
  let lightboxPointerMoved = false;

  const renderLightboxImage = () => {
    if (!(lightboxImage instanceof HTMLImageElement)) return;
    lightboxImage.style.transform = `translate(${lightboxX}px, ${lightboxY}px) scale(${lightboxZoom})`;
    if (lightboxScale instanceof HTMLOutputElement) {
      lightboxScale.textContent = `${Math.round(lightboxZoom * 100)}%`;
    }
  };

  const resetLightboxImage = () => {
    lightboxZoom = 1;
    lightboxX = 0;
    lightboxY = 0;
    renderLightboxImage();
  };

  const animateNextLightboxTransform = () => {
    if (!(lightbox instanceof HTMLElement)) return;
    lightbox.classList.add('zooming');
    window.setTimeout(() => {
      lightbox.classList.remove('zooming');
    }, 220);
  };

  const resetLightboxImageAnimated = () => {
    animateNextLightboxTransform();
    resetLightboxImage();
  };

  const zoomLightboxBy = (factor, originX, originY) => {
    const previousZoom = lightboxZoom;
    lightboxZoom = clamp(lightboxZoom * factor, 0.5, 6);
    if (lightboxZoom === previousZoom) return;

    if (
      typeof originX === 'number' &&
      typeof originY === 'number' &&
      lightboxImage instanceof HTMLImageElement
    ) {
      const rect = lightboxImage.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const zoomRatio = lightboxZoom / previousZoom;
      lightboxX += (centerX - originX) * (zoomRatio - 1);
      lightboxY += (centerY - originY) * (zoomRatio - 1);
    }

    if (Math.abs(lightboxZoom - 1) < 0.01) {
      lightboxZoom = 1;
      lightboxX = 0;
      lightboxY = 0;
    }
    renderLightboxImage();
  };

  const waitForLightboxImage = async () => {
    if (!(lightboxImage instanceof HTMLImageElement)) return;
    if (lightboxImage.complete && lightboxImage.naturalWidth > 0) return;

    try {
      await lightboxImage.decode();
    } catch {
      await new Promise((resolve) => {
        lightboxImage.addEventListener('load', resolve, { once: true });
        lightboxImage.addEventListener('error', resolve, { once: true });
      });
    }
  };

  const nextFrame = () => new Promise((resolve) => requestAnimationFrame(resolve));

  const animateOpenFrom = async (sourceImage, openToken) => {
    if (!(lightbox instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement)) return;

    lightbox.classList.add('opening');
    await waitForLightboxImage();
    if (openToken !== lightboxOpenToken || !lightbox.classList.contains('open')) return;

    const from = sourceImage.getBoundingClientRect();
    const to = lightboxImage.getBoundingClientRect();
    if (!from.width || !from.height || !to.width || !to.height) {
      lightbox.classList.remove('opening');
      return;
    }

    const flightImage = sourceImage.cloneNode(true);
    flightImage.className = 'lightbox-flight-image';
    flightImage.removeAttribute('loading');
    flightImage.style.left = `${from.left}px`;
    flightImage.style.top = `${from.top}px`;
    flightImage.style.width = `${from.width}px`;
    flightImage.style.height = `${from.height}px`;
    document.body.appendChild(flightImage);

    const animation = flightImage.animate(
      [
        {
          left: `${from.left}px`,
          top: `${from.top}px`,
          width: `${from.width}px`,
          height: `${from.height}px`,
          opacity: 0.78,
        },
        {
          left: `${to.left}px`,
          top: `${to.top}px`,
          width: `${to.width}px`,
          height: `${to.height}px`,
          opacity: 1,
        },
      ],
      {
        duration: 320,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      }
    );

    await animation.finished.catch(() => undefined);
    if (openToken !== lightboxOpenToken || !lightbox.classList.contains('open')) {
      flightImage.remove();
      return;
    }
    lightbox.classList.remove('opening');
    await nextFrame();
    await nextFrame();
    flightImage.remove();
  };

  document.querySelectorAll('.project-figure a').forEach((frame) => {
    const image = frame.querySelector('img');
    if (!image) return;

    frame.setAttribute('draggable', 'false');
    image.setAttribute('draggable', 'false');

    frame.addEventListener('click', (event) => {
      event.preventDefault();
      if (!(lightbox instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement)) {
        return;
      }

      lightboxImage.src = frame.href;
      lightboxImage.alt = image.alt;
      resetLightboxImage();
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lightbox-open');
      lightboxOpenToken += 1;
      void animateOpenFrom(image, lightboxOpenToken);
    });

    frame.addEventListener('dragstart', (event) => {
      event.preventDefault();
    });
  });

  const closeLightbox = () => {
    if (!(lightbox instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement)) {
      return;
    }

    lightbox.classList.remove('open');
    lightbox.classList.remove('opening', 'dragging');
    lightboxOpenToken += 1;
    document.querySelectorAll('.lightbox-flight-image').forEach((image) => image.remove());
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxImage.removeAttribute('src');
    resetLightboxImage();
    activePointers.clear();
    isLightboxDragging = false;
    document.documentElement.classList.remove('lightbox-open');
  };

  lightbox?.addEventListener('click', (event) => {
    if (lightboxPointerMoved) {
      lightboxPointerMoved = false;
      return;
    }
    if (event.target instanceof HTMLElement && event.target.closest('.lightbox-toolbar')) return;
    if (lightboxImage instanceof HTMLImageElement) {
      const imageRect = lightboxImage.getBoundingClientRect();
      const isInsideImage =
        event.clientX >= imageRect.left &&
        event.clientX <= imageRect.right &&
        event.clientY >= imageRect.top &&
        event.clientY <= imageRect.bottom;
      if (isInsideImage) return;
    }
    closeLightbox();
  });

  const handleLightboxWheel = (event) => {
    if (!(lightbox instanceof HTMLElement) || !lightbox.classList.contains('open')) return;
    if (event.target instanceof HTMLElement && event.target.closest('.lightbox-toolbar')) return;
    if (event.defaultPrevented) return;

    event.preventDefault();
    const normalizedDelta = clamp(event.deltaY, -120, 120);
    const sensitivity = event.ctrlKey ? 0.003 : 0.0012;
    zoomLightboxBy(Math.exp(-normalizedDelta * sensitivity), event.clientX, event.clientY);
  };

  lightbox?.addEventListener('wheel', handleLightboxWheel, { passive: false });
  lightboxImage?.addEventListener('wheel', handleLightboxWheel, { passive: false });

  const handleGestureStart = (event) => {
    event.preventDefault();
    gestureStartZoom = lightboxZoom;
  };

  const handleGestureChange = (event) => {
    if (!(lightbox instanceof HTMLElement) || !lightbox.classList.contains('open')) return;
    event.preventDefault();
    const nextZoom = clamp(gestureStartZoom * event.scale, 0.5, 6);
    zoomLightboxBy(nextZoom / lightboxZoom, event.clientX, event.clientY);
  };

  lightbox?.addEventListener('gesturestart', handleGestureStart, { passive: false });
  lightbox?.addEventListener('gesturechange', handleGestureChange, { passive: false });

  lightbox?.addEventListener('pointerdown', (event) => {
    if (event.target instanceof HTMLElement && event.target.closest('.lightbox-toolbar')) return;
    event.preventDefault();
    activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

    if (activePointers.size === 2) {
      const [first, second] = [...activePointers.values()];
      pinchStartDistance = Math.hypot(second.x - first.x, second.y - first.y);
      pinchStartZoom = lightboxZoom;
      isLightboxDragging = false;
      lightbox.classList.remove('dragging');
      return;
    }

    isLightboxDragging = true;
    dragStartX = event.clientX;
    dragStartY = event.clientY;
    lightboxPointerMoved = false;
    startX = lightboxX;
    startY = lightboxY;
    lightbox.classList.add('dragging');
    lightbox.setPointerCapture(event.pointerId);
  });

  lightbox?.addEventListener('pointermove', (event) => {
    if (activePointers.has(event.pointerId)) {
      activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
    }

    if (activePointers.size === 2 && pinchStartDistance > 0) {
      const [first, second] = [...activePointers.values()];
      const distance = Math.hypot(second.x - first.x, second.y - first.y);
      const centerX = (first.x + second.x) / 2;
      const centerY = (first.y + second.y) / 2;
      const nextZoom = clamp(pinchStartZoom * (distance / pinchStartDistance), 0.5, 6);
      zoomLightboxBy(nextZoom / lightboxZoom, centerX, centerY);
      return;
    }

    if (!isLightboxDragging) return;
    if (Math.hypot(event.clientX - dragStartX, event.clientY - dragStartY) > 4) {
      lightboxPointerMoved = true;
    }
    lightboxX = startX + event.clientX - dragStartX;
    lightboxY = startY + event.clientY - dragStartY;
    renderLightboxImage();
  });

  const stopLightboxDrag = (event) => {
    if (!(lightbox instanceof HTMLElement) || !isLightboxDragging) return;
    activePointers.delete(event.pointerId);
    isLightboxDragging = false;
    lightbox.classList.remove('dragging');
    if (lightbox.hasPointerCapture(event.pointerId)) {
      lightbox.releasePointerCapture(event.pointerId);
    }
  };

  const stopPointer = (event) => {
    activePointers.delete(event.pointerId);
    stopLightboxDrag(event);
  };

  lightbox?.addEventListener('pointerup', stopPointer);
  lightbox?.addEventListener('pointercancel', stopPointer);
  lightbox?.addEventListener('dblclick', (event) => {
    if (event.target instanceof HTMLElement && event.target.closest('.lightbox-toolbar')) return;
    event.preventDefault();
    event.stopPropagation();
    animateNextLightboxTransform();
    if (lightboxZoom < 1.6) {
      zoomLightboxBy(2.25 / lightboxZoom, event.clientX, event.clientY);
    } else {
      resetLightboxImage();
    }
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxZoomIn?.addEventListener('click', () => zoomLightboxBy(1.2));
  lightboxZoomOut?.addEventListener('click', () => zoomLightboxBy(1 / 1.2));
  lightboxReset?.addEventListener('click', resetLightboxImageAnimated);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
    if (!(lightbox instanceof HTMLElement) || !lightbox.classList.contains('open')) return;
    if (event.key === '+' || event.key === '=') zoomLightboxBy(1.18);
    if (event.key === '-') zoomLightboxBy(1 / 1.18);
    if (event.key === '0') resetLightboxImageAnimated();
  });
</script>
